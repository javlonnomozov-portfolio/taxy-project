{
  "name": "toy-taxy",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @tty/api start:dev",
    "dev:bot": "pnpm --filter @tty/bot start:dev",
    "dev:admin": "pnpm --filter @tty/admin dev",
    "db:up": "docker-compose up -d postgres redis",
    "db:down": "docker-compose down",
    "migration:run": "pnpm --filter @tty/api migration:run",
    "migration:generate": "pnpm --filter @tty/api migration:generate",
    "sim:dispatch": "node scripts/dispatch-sim.mjs",
    "sim:trip": "node scripts/trip-sim.mjs",
    "sim:sprint3": "node scripts/sprint3-sim.mjs",
    "sim:bot": "node scripts/bot-flow-sim.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "sim:race": "node scripts/race-sim.mjs",
    "typecheck": "pnpm -r typecheck",
    "sim:security": "node scripts/security-sim.mjs",
    "sim:cluster": "node scripts/cluster-sim.mjs",
    "sim:online-geo": "node scripts/online-geo-sim.mjs",
    "sim:late-driver": "node scripts/late-driver-sim.mjs",
    "sim:miniapp": "node scripts/miniapp-sim.mjs",
    "sim:arrived-guard": "node scripts/arrived-guard-sim.mjs",
    "sim:miniapp-sync": "node scripts/miniapp-bot-sync-sim.mjs",
    "sim:per-order": "node scripts/per-order-billing-sim.mjs",
    "sim:customer-cancel": "node scripts/customer-cancel-sim.mjs",
    "sim:offline-withdraw": "node scripts/offline-withdraw-sim.mjs",
    "sim:trip-history": "node scripts/trip-history-sim.mjs",
    "sim:trip-resume": "node scripts/trip-resume-sim.mjs",
    "sim:miniapp-rating": "node scripts/miniapp-rating-sim.mjs",
    "sim:customer-auth": "node scripts/customer-auth-sim.mjs",
    "try:login": "node scripts/customer-login-try.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "ioredis": "^5.4.1",
    "prettier": "^3.3.3",
    "socket.io-client": "^4.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0"
  }
}

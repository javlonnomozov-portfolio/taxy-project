{
  "expo": {
    "name": "Toy TaxY Haydovchi",
    "slug": "tty-driver",
    "owner": "jav1on",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ttydriver",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Buyurtmalarni olish uchun joylashuv kerak.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Fon rejimida buyurtmalarni olish uchun joylashuv kerak.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification",
          "location",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "uz.toytaxy.driver",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B40496"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Buyurtmalarni olish uchun joylashuv kerak.",
          "locationAlwaysAndWhenInUsePermission": "Fon rejimida joylashuv kerak.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4c8dff"
        }
      ],
      "./plugins/withAndroidRelease"
    ],
    "extra": {
      "apiUrl": "https://api-production-13444.up.railway.app",
      "eas": {
        "projectId": "862b155e-1193-4c77-87fb-0cb63e29ee9e"
      }
    }
  }
}

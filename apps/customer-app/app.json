{
  "expo": {
    "name": "Toy TaxY",
    "slug": "tty-customer",
    "owner": "jav1on",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "ttycustomer",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "uz.toytaxy.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1E"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Taksi chaqirish uchun joylashuvingiz kerak."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api-production-13444.up.railway.app",
      "eas": {
        "projectId": "c3ad9431-a59d-4076-b067-002b1b96b9de"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}

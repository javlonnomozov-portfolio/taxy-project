# ---- Umumiy ----
NODE_ENV=development

# ---- Postgres (docker-compose) ----
POSTGRES_USER=tty
POSTGRES_PASSWORD=tty_pass
POSTGRES_DB=tty
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- API (apps/api) ----
API_PORT=3000
# Railway PORT'ni avtomatik beradi (API_PORT faqat lokal uchun)
DATABASE_URL=postgres://tty:tty_pass@localhost:5432/tty
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=dev_internal_key
# Bootstrap super-admin (birinchi ishga tushganda yaratiladi)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
# Dispatch (ixtiyoriy — default qiymatlar bor)
DISPATCH_WINDOW_SIZE=6
DISPATCH_OFFER_TIMEOUT_SEC=15
DISPATCH_RADIUS_STEPS_M=2000,4000,6000
DISPATCH_NO_DRIVER_TIMEOUT_SEC=60
# Login urinishlari HAR HISOB uchun daqiqasiga (brute force himoyasi).
# Prod'da 5 qoldiring; sim skriptlarini ketma-ket haydashda vaqtincha oshiring.
LOGIN_RATE_LIMIT=5
# Swagger /docs — prod'da faqat 'true' bo'lsa ochiladi (dev'da har doim ochiq).
SWAGGER_ENABLED=false

# ---- Bot (apps/bot) ----
BOT_TOKEN=your_telegram_bot_token
API_BASE_URL=http://localhost:3000

# ---- Xarita xizmatlari (keyingi bosqich) ----
OSRM_URL=
GEOCODE_URL=

# ---- Push (keyingi bosqich) ----
FCM_SERVER_KEY=

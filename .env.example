# ---- Umumiy ----
NODE_ENV=development

# ---- Postgres (docker-compose) ----
POSTGRES_USER=tty
POSTGRES_PASSWORD=tty_pass
POSTGRES_DB=tty
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- API (apps/api) ----
API_PORT=3000
# Railway PORT'ni avtomatik beradi (API_PORT faqat lokal uchun)
DATABASE_URL=postgres://tty:tty_pass@localhost:5432/tty
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=dev_internal_key
# Dispatch (ixtiyoriy — default qiymatlar bor)
DISPATCH_WINDOW_SIZE=6
DISPATCH_OFFER_TIMEOUT_SEC=15
DISPATCH_RADIUS_STEPS_M=2000,4000,6000
DISPATCH_NO_DRIVER_TIMEOUT_SEC=60

# ---- Bot (apps/bot) ----
BOT_TOKEN=your_telegram_bot_token
API_BASE_URL=http://localhost:3000

# ---- Xarita xizmatlari (keyingi bosqich) ----
OSRM_URL=
GEOCODE_URL=

# ---- Push (keyingi bosqich) ----
FCM_SERVER_KEY=
